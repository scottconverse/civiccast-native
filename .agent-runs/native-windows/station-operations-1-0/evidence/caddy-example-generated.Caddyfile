# Generated by CivicCast. Caddy must be directly reachable by clients.
{
    admin off
}

http://watch.example.gov, http://staff.example.gov {
    bind 192.168.50.8 [2001:db8:50::8]
    redir https://{host}{uri} permanent
}

https://watch.example.gov {
    bind 192.168.50.8 [2001:db8:50::8]
    route {
        @resident path / /assets/* /favicon.svg /api/public/* /media/vod/* /media/live/*
        reverse_proxy @resident 127.0.0.1:8123 {
            header_up X-Forwarded-For {http.request.remote.host}
            header_up X-Forwarded-Proto {http.request.scheme}
            header_up X-Forwarded-Host {http.request.host}
            header_up X-Real-IP {http.request.remote.host}
            header_up -Forwarded
        }
        respond "Not found" 404
    }
}

https://staff.example.gov {
    bind 192.168.50.8 [2001:db8:50::8]
    route {
        @first_setup path /api/setup /api/setup/*
        respond @first_setup "First setup is available only on the station computer." 403
        @staff_access remote_ip 192.168.50.0/24 2001:db8:50::/64
        reverse_proxy @staff_access 127.0.0.1:8123 {
            header_up X-Forwarded-For {http.request.remote.host}
            header_up X-Forwarded-Proto {http.request.scheme}
            header_up X-Forwarded-Host {http.request.host}
            header_up X-Real-IP {http.request.remote.host}
            header_up -Forwarded
        }
        respond "Staff access is limited to approved networks." 403
    }
}
