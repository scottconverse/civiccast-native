# Generated by CivicCast. Caddy must be directly reachable by clients.
{
    admin off
    auto_https disable_redirects
    skip_install_trust
}

https://watch.localhost:18443 {
    bind 127.0.0.1
    tls internal
    route {
        @resident path / /assets/* /favicon.svg /api/public/* /media/vod/* /media/live/*
        reverse_proxy @resident 127.0.0.1:18080 {
            header_up X-Forwarded-For {http.request.remote.host}
            header_up X-Forwarded-Proto {http.request.scheme}
            header_up X-Forwarded-Host {http.request.host}
            header_up X-Real-IP {http.request.remote.host}
            header_up -Forwarded
        }
        respond "Not found" 404
    }
}

https://staff.localhost:18443 {
    bind 127.0.0.1
    tls internal
    route {
        @first_setup path /api/setup /api/setup/*
        respond @first_setup "First setup is available only on the station computer." 403
        @staff_access remote_ip 127.0.0.1/32
        reverse_proxy @staff_access 127.0.0.1:18080 {
            header_up X-Forwarded-For {http.request.remote.host}
            header_up X-Forwarded-Proto {http.request.scheme}
            header_up X-Forwarded-Host {http.request.host}
            header_up X-Real-IP {http.request.remote.host}
            header_up -Forwarded
        }
        respond "Staff access is limited to approved networks." 403
    }
}
