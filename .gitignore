# Release-evidence cleanroom logs are intentionally tracked so each
# tag-candidate's local Windows cleanroom proof is durable. Per the
# release-close directive (Codex audit-team verification protocol),
# these logs are part of the v0.X.Y verification record.
!docs/releases/evidence/*.log

# Secrets and local config
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
credentials/
*.credentials.json
.netrc

# CivicCast-specific
# HANDOFF.md is gitignored — used for private session handoffs (always current,
# never committed). next-cleanup.md IS committed (CLAUDE.md treats it as a
# tracked artifact for layered-audit Minor/Nit collection).
HANDOFF.md
.civiccast-local/

# Agentic pipeline run artifacts (local only, never committed) — EXCEPT
# .agent-runs/native-windows/, the native-Windows program's committed audit
# trail (requests, evidence, verdict pointers; see its README).
.agent-runs/*
!.agent-runs/native-windows/
# Keep generic machine-local run state out of the committed evidence tree.
.agent-runs/native-windows/**/*.local
# ...and evidence transcripts ARE committed despite the global *.log rule
# (including per-run subfolders like evidence/gauntlet-run17/ -- the
# single-level pattern silently dropped 6-7 logs per gauntlet run)
!.agent-runs/native-windows/**/evidence/*.log
!.agent-runs/native-windows/**/evidence/**/*.log
# ...and the WS4 WSL-keeper-patch cargo transcript (CC-WS4-008 root cause:
# the round-1 build's committed-path claim for this exact file silently
# failed against the blanket *.log rule above with no negation for
# wsl-keeper-patch/ -- that is WHY it was "absent from the committed tree"
# per the round-1 auditor finding; this negation is the actual fix)
!.agent-runs/native-windows/**/wsl-keeper-patch/*.log
streams/
recordings/
captions-cache/
whisper-models/
ollama-models/

# Database
*.sqlite
*.sqlite3
*.db
postgres-data/

# Media test fixtures (large)
tests/fixtures/media/*.mp4
tests/fixtures/media/*.mkv
tests/fixtures/media/*.ts
tests/fixtures/media/*.m4s

# Pandoc output
*.pdf
*.docx
!docs/USER-MANUAL.pdf
!docs/USER-MANUAL.docx
!docs/spec/*.pdf
!docs/spec/*.docx
!tests/agenda_import/fixtures/*.pdf

# Pre-commit
.pre-commit-trash/

# Docs site builds
site/
docs/_build/

# Proof-kit installer binaries must not be committed (they bloated the repo via
# LFS by ~640 MB). Distribute them as GitHub Release assets instead.
tester-handoff/**/*.zip
tester-handoff/**/*.exe
tester-handoff/**/*.msi
tester-handoff/**/civiccast-*-release-artifacts-manifest.json
.fablize/

# AntiStall sprint state — per-session, never shared
.claude/sprint-gate-*.json
.claude/sprint-stop-request.json
.claude/.antistall-block-count-*

# rigor-goals per-session story state — process artifact, never shared
.rigor/
.pytest-tmp-*/
.tmp-pytest-root/

# Gate A (docs/ops/gate-a.md) — per-run state, never committed. Rendered
# .wsb, live run output, the persistent install dir, staged/resolved kit
# downloads (multi-GB), and evidence copies all live under sandbox-lab/ and
# are regenerated by sandbox-lab/Run-GateA.ps1 on every run.
sandbox-lab/CivicCastSandboxTest.wsb
sandbox-lab/output/*
!sandbox-lab/output/.gitkeep
sandbox-lab/hoststore/*
!sandbox-lab/hoststore/.gitkeep
sandbox-lab/kit-download/*
# kit-download has no .gitkeep exception: Run-GateA.ps1 replaces the whole
# directory with an NTFS junction to the resolved kit on every run, so a
# tracked placeholder file inside it can never survive a run (see docs/ops/gate-a.md).
sandbox-lab/kit-staging/*
!sandbox-lab/kit-staging/.gitkeep
sandbox-lab/evidence/*
!sandbox-lab/evidence/.gitkeep

# ...but the committed Gate A test fixture (a verbatim historical sandbox
# run's output/ dir) carries real .log evidence files that must survive the
# blanket *.log rule above -- same pattern as the .agent-runs negations.
!tests/gate_a/fixtures/**/*.log

# S12 OTT apps: civiccast-player.js is canonically ONE file at
# civiccast/apps/ott-native/web-shared/civiccast-player.js, shared by the
# Tizen and webOS targets. The build step (ci-ott-apps.yml) and local dev
# (see each README) copy it into these directories before packaging; the
# copy is a build artifact, not a second source of truth.
civiccast/apps/ott-native/tizen/civiccast-player.js
civiccast/apps/ott-native/webos/civiccast-player.js
civiccast/apps/ott-native/roku/out/
