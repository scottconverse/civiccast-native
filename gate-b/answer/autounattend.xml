<!--
  SPDX-License-Identifier: Apache-2.0
  Copyright (c) The CivicCast Authors

  Gate B unattended-setup answer file.

  (Note on style: XML comments may not contain a double hyphen, so the prose
  below uses single dashes where the rest of this repository would use an
  em dash. That is a syntax constraint, not a change of voice.)

  USED ONLY BY THE -WindowsIso PATH of gate-b/Provision-GateBVm.ps1, which
  applies install.wim to a fresh VHDX and copies this file to
  <vhdx>\Windows\Panther\unattend.xml. On the primary -BaseVhdx path this file
  is not touched at all.

  WHAT IT IS FOR, AND WHY IT IS THE WHOLE ISO PATH IN ONE FILE. A Windows
  image applied straight out of install.wim boots to OOBE and waits for a
  human, forever. Gate B's entire premise is that nobody is present, so the
  first boot has to complete setup on its own and leave behind an account
  PowerShell Direct can use. That is what the oobeSystem pass below does.

  THE PASSWORD IS A PLACEHOLDER AND THE OPERATOR MUST CHANGE IT.
  This file ships with the literal string CHANGE-ME-BEFORE-USE. Provisioning
  will produce a VM you cannot log into until you replace it, which is
  deliberate: a checked-in answer file carrying a working credential is a
  checked-in credential, and this repository does not have those. Whatever you
  set here must MATCH the credential you exported for -GuestCredentialPath:

      Get-Credential | Export-CliXml C:\CivicCastGateB\guest-cred.xml
      Username: gatebadmin
      Password: the same one you put below

  The account it creates is local, exists only inside a disposable soak VM on
  an isolated (network-adapter-free) Hyper-V guest, and is destroyed with the
  VM. It is not a credential for any real system.

  DEFAULTS WORTH KNOWING:
    * en-US throughout. Change it if your ISO is a different language; a
      mismatch makes setup stop and ask, which presents as a hang, not as an
      error.
    * Windows Update is left alone. Gate B does not disable patching: a VM
      with no network adapter cannot reach Windows Update anyway, and
      disabling it here would make the soak less like a real station rather
      than more.
    * No DiskConfiguration section. Provision-GateBVm.ps1 has already
      partitioned and formatted the VHDX and run bcdboot against it, so
      letting Windows Setup repartition would destroy the image it is
      booting from.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">

  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <ComputerName>GATEB-SOAK</ComputerName>
      <TimeZone>UTC</TimeZone>
    </component>
  </settings>

  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>

    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideLocalAccountScreen>true</HideLocalAccountScreen>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>

      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Name>gatebadmin</Name>
            <DisplayName>Gate B Soak Admin</DisplayName>
            <Description>Local admin for the CivicCast Gate B 24h reboot soak VM.</Description>
            <Group>Administrators</Group>
            <Password>
              <!-- REPLACE THIS. See the header comment. -->
              <Value>CHANGE-ME-BEFORE-USE</Value>
              <PlainText>true</PlainText>
            </Password>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>

      <!--
        NO AutoLogon element, on purpose.

        Auto-logon would create an interactive desktop session on every boot,
        and the agent's own unattendedness measurement (Test-Unattended,
        which checks for explorer.exe) would then read FALSE for every
        post-reboot beat. Correctly so: a box that logs itself in is not a box
        surviving with nobody there. The agent resumes from an AtStartup
        SYSTEM task instead, which needs no session at all. See
        gate-b/scripts/Register-GateBStartupTask.ps1.
      -->
    </component>
  </settings>

</unattend>
