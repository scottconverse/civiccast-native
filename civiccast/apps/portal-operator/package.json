{
  "name": "portal-operator",
  "private": true,
  "version": "1.0.0-beta.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "python ../../../scripts/generate-openapi-artifacts.py",
    "check:api": "python ../../../scripts/generate-openapi-artifacts.py --check",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:a11y": "playwright test --grep-invert @fullstack",
    "prepare:public-portal": "npm --prefix ../portal-public ci --no-audit --no-fund && npm --prefix ../portal-public run build",
    "test:fullstack": "npm run prepare:public-portal && playwright test --grep @fullstack"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.9"
  }
}
