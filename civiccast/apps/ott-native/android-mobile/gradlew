#!/bin/sh
# Gradle start-up script — minimal stub.
# In a fresh checkout, run `gradle wrapper --gradle-version 8.7` once to materialize the real gradlew + gradle-wrapper.jar.
# We omit the binary jar from this starter to keep the source tree text-only and reviewable.
DIR="$(cd "$(dirname "$0")" && pwd)"
if [ ! -f "$DIR/gradle/wrapper/gradle-wrapper.jar" ]; then
  echo "gradle-wrapper.jar missing. Run: gradle wrapper --gradle-version 8.7" >&2
  exit 1
fi
exec java -classpath "$DIR/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
