{
  "version": "1.8.2",
  "source": "shared-app-platform-shell-runtime",
  "certifiedIntegratorGuidance": [
    "Build from the reviewed target artifact generated by npm.cmd run build.",
    "Use the station config URL supplied by the operator; do not fork target-specific content catalogs.",
    "Verify live playback, VOD playback, captions, audio tracks, chapters, schedule browsing, and branding before store submission.",
    "Document external account, store review, and device certification steps as deployment work, not CivicCast product gaps."
  ],
  "monitoringChecklist": [
    "station-config-fetch",
    "live-state-fetch",
    "live-playback-url-present",
    "vod-catalog-fetch",
    "schedule-feed-fetch",
    "caption-track-present-when-advertised",
    "app-branding-applied"
  ],
  "targets": [
    {
      "appTarget": "web_pwa",
      "label": "Web/PWA",
      "proofClass": "browser-local",
      "inputModel": "keyboard-pointer-touch",
      "packaging": "static web artifact plus web app manifest",
      "externalRequirements": ["hosting domain", "TLS certificate"]
    },
    {
      "appTarget": "roku",
      "label": "Roku",
      "proofClass": "living-room-local",
      "inputModel": "remote-directional",
      "packaging": "certified-integrator channel package",
      "externalRequirements": ["developer account", "device certification", "store review"]
    },
    {
      "appTarget": "tvos",
      "label": "tvOS",
      "proofClass": "living-room-package",
      "inputModel": "remote-directional",
      "packaging": "certified-integrator tvOS package",
      "externalRequirements": ["developer account", "device certification", "store review"]
    },
    {
      "appTarget": "fire_tv",
      "label": "Fire TV",
      "proofClass": "living-room-package",
      "inputModel": "remote-directional",
      "packaging": "certified-integrator Fire TV package",
      "externalRequirements": ["developer account", "device certification", "store review"]
    },
    {
      "appTarget": "android_tv",
      "label": "Android TV",
      "proofClass": "living-room-package",
      "inputModel": "remote-directional",
      "packaging": "certified-integrator Android TV package",
      "externalRequirements": ["developer account", "device certification", "store review"]
    },
    {
      "appTarget": "android_mobile",
      "label": "Android mobile",
      "proofClass": "mobile-local",
      "inputModel": "touch",
      "packaging": "certified-integrator Android package",
      "externalRequirements": ["developer account", "device certification", "store review"]
    },
    {
      "appTarget": "ios_ipados",
      "label": "iOS/iPadOS",
      "proofClass": "mobile-package",
      "inputModel": "touch",
      "packaging": "certified-integrator iOS/iPadOS package",
      "externalRequirements": ["developer account", "device certification", "store review"]
    }
  ]
}
